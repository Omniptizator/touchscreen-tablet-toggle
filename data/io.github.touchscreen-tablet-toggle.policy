<policyconfig>
  <action id="io.github.touchscreen-tablet-toggle.configure">
    <description>Configure tablet-only touchscreen input</description>
    <message>An active local session is required to configure the touchscreen</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
